# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API

# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — keep this SECRET, only used in API routes (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard password (default: jobingen-admin-2026)
ADMIN_PASSWORD=jobingen-admin-2026

# ─── Adzuna job ingest (/api/ingest) ──────────────────────────────────────────
# https://developer.adzuna.com — required or the ingest returns 0 jobs
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Shared secret guarding GET /api/ingest?secret=...
INGEST_SECRET=any-long-random-string

# ─── JobEngine (/jobengine) ───────────────────────────────────────────────────
# Shared secret guarding manual runs: GET /api/jobengine/crawl?secret=...
JOBENGINE_CRON_SECRET=any-long-random-string

# Set in Vercel project settings (not here) — Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`, since a cron path can't carry a query.
# CRON_SECRET=

# Claude — job scoring + resume tailoring. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gemini — embeddings for the cheap prefilter pass. https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key
