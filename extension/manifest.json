{
  "manifest_version": 3,
  "name": "JobEngine Auto-Apply",
  "version": "1.0.0",
  "description": "Auto-fills Greenhouse & Lever job application forms with your JobEngine profile — you attach the resume and submit.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobEngine Auto-Apply"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.greenhouse.io/*", "*://*.lever.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
